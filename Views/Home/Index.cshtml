@model List<OnlineStoreWeb.Models.ProductModel>

<div class="container-fluid p-0">

    <!-- HERO -->

    <div class="hero-section d-flex align-items-center justify-content-center text-center">

        <div class="hero-overlay">

            <h1 class="display-2 fw-bold text-white">
                New Collection
            </h1>

            <p class="lead text-white mt-3">
                Luxury Home & Gifts
            </p>

            <a href="/Products"
               class="btn btn-light btn-lg px-5 mt-3">

                Shop Now

            </a>

        </div>

    </div>

</div>

<!-- CATEGORIES -->

<div class="container mt-5">

    <div class="d-flex gap-3 flex-wrap justify-content-center">

        <button class="btn btn-outline-dark rounded-pill px-4">
            All
        </button>

        <button class="btn btn-outline-dark rounded-pill px-4">
            Bags
        </button>

        <button class="btn btn-outline-dark rounded-pill px-4">
            Shoes
        </button>

        <button class="btn btn-outline-dark rounded-pill px-4">
            Accessories
        </button>

        <button class="btn btn-outline-dark rounded-pill px-4">
            Offers
        </button>

    </div>

</div>

<!-- PRODUCTS -->

<div class="container mt-5">

    <div class="row">

        @foreach (var item in Model.Take(12))
        {
            <div class="col-md-3 mb-4">

                <div class="card border-0 shadow-sm product-card h-100">

               

                    <img src="@(string.IsNullOrEmpty(item.Image)
                             ? "https://via.placeholder.com/300x250"
                             : item.Image)"
                     class="card-img-top product-image">


                    <div class="card-body">

                        <h5 class="fw-bold">
                            @item.Name
                        </h5>

                        <p class="text-danger fw-bold fs-5">
                            @item.Price JD
                        </p>
                        <div class="d-flex gap-2">

                            <a href="/Products/Details/@item.Id"
                               class="btn btn-outline-dark w-50 rounded-pill">
                                Details
                            </a>

                            <a asp-controller="Products"
                               asp-action="AddToCart"
                               asp-route-id="@item.Id"
                               asp-route-name="@item.Name"
                               asp-route-price="@item.Price"
                               class="btn btn-dark w-50 rounded-pill">
                                Add
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<style>

    .hero-section {
        height: 650px;
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=2070');
        background-size: cover;
        background-position: center;
    }

    .hero-overlay {
        padding: 40px;
        border-radius: 20px;
    }

    .product-card {
        transition: 0.3s;
        overflow: hidden;
        border-radius: 20px;
    }

        .product-card:hover {
            transform: translateY(-8px);
        }

    .product-image {
        height: 320px;
        object-fit: cover;
    }

</style>