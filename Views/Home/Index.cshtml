@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model List<OnlineStoreWeb.Models.ProductModel>

<div class="container-fluid p-0">

    <!-- HERO -->

    <div id="heroSlider"
         class="carousel slide carousel-fade hero-slider"
         data-bs-ride="carousel"
         data-bs-interval="2000">


       

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="~/images/hero/1.png"
                     class="d-block w-100 hero-image">
            </div>

            <div class="carousel-item">
                <img src="~/images/hero/2.png"
                     class="d-block w-100 hero-image">
            </div>

            <div class="carousel-item">
                <img src="~/images/hero/3.png"
                     class="d-block w-100 hero-image">
            </div>

           <div class="carousel-item">
                <img src="~/images/hero/4.png"
                     class="d-block w-100 hero-image">
            </div>

        </div>

    </div>

</div>



<!-- PRODUCTS -->

<div class="container mt-5">

    <div class="row">

        @foreach (var item in Model.Take(12))
        {
            <div class="col-md-3 mb-4" id="@item.Id">

                <div class="card border-0 shadow-sm product-card h-100">

               

       

                    <img src="@(string.IsNullOrEmpty(item.Image)
                         ? "/images/no-image.png"
                         : item.Image)"
                     class="card-img-top product-image"
                     alt="@item.Name"
                     onerror="this.onerror=null; this.src='/images/no-image.png';">

                    <div class="card-body">

                        <h5 class="fw-bold">
                            @item.Name
                        </h5>

                        <p class="text-danger fw-bold fs-5">
                            @Localizer["Price"]: @item.Price JD
                        </p>
                        <div class="d-flex gap-2">

                            <a href="/Products/Details/@item.Id"
                               class="btn btn-outline-dark w-50 rounded-pill">
                                @Localizer["Details"]
                            </a>

                            <a asp-controller="Products"
                               asp-action="AddToCart"
                               asp-fragment="@item.Id"
                               asp-route-id="@item.Id"
                               asp-route-name="@item.Name"
                               asp-route-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               class="btn btn-dark w-50 rounded-pill">
                                @Localizer["AddToCart"]
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<style>

    .hero-section {
        height: 650px;
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=2070');
        background-size: cover;
        background-position: center;
    }

    .hero-overlay {
        padding: 40px;
        border-radius: 20px;
    }

    .product-card {
        transition: 0.3s;
        overflow: hidden;
        border-radius: 20px;
    }

        .product-card:hover {
            transform: translateY(-8px);
        }

    .product-image {
        height: 320px;
        object-fit: cover;
    }

</style>