@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model List<OnlineStoreWeb.Models.OnlineOrderModel>

<div class="container mt-5">

    <!-- PAGE TITLE -->

    <div class="mb-4">

        <h2 class="fw-bold mb-4">
            <i class="bi bi-bag-check me-2"></i>
            @Localizer["OnlineOrders"]
        </h2>

    </div>

    <!-- STATS -->

    <div class="row g-3 mb-4">

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-cart-check fs-1 text-dark"></i>

                    <h6 class="text-muted mt-2">
                        @Localizer["TotalOrders"]
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalOrders
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-hourglass-split fs-1 text-warning"></i>

                    <h6 class="text-muted mt-2">
                        @Localizer["Pending"]
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @ViewBag.PendingOrders
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-check-circle fs-1 text-success"></i>

                    <h6 class="text-muted mt-2">
                        @Localizer["Paid"]
                    </h6>

                    <h2 class="fw-bold text-success">
                        @ViewBag.PaidOrders
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-cash-stack fs-1 text-danger"></i>

                    <h6 class="text-muted mt-2">
                        @Localizer["Sales"]
                    </h6>

                    <h2 class="fw-bold text-danger"
                        style="white-space:nowrap">

                        @ViewBag.TotalSales.ToString("0.000")
                        @Localizer["Currency"]

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- SEARCH -->

    <div class="row mb-4">

        <div class="col-md-6">

            <form method="get">

                <div class="input-group">

                    <input type="text"
                           name="search"
                           value="@Context.Request.Query["search"]"
                           class="form-control"
                           placeholder="@Localizer["SearchOrders"]" />

                    <button class="btn btn-dark">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- FILTERS -->

    <div class="d-flex gap-2 mb-4 flex-wrap">

        <a asp-controller="Admin"
           asp-action="Orders"
           class="btn btn-dark btn-sm rounded-pill px-4">

            @Localizer["All"]

        </a>

        <a asp-controller="Admin"
           asp-action="Orders"
           asp-route-status="Pending"
           class="btn btn-warning btn-sm rounded-pill px-4">

            @Localizer["Pending"]

        </a>

        <a asp-controller="Admin"
           asp-action="Orders"
           asp-route-status="Paid"
           class="btn btn-success btn-sm rounded-pill px-4">

            @Localizer["Paid"]

        </a>

        <a asp-controller="Admin"
           asp-action="Orders"
           asp-route-status="Delivered"
           class="btn btn-primary btn-sm rounded-pill px-4">

            @Localizer["Delivered"]

        </a>

    </div>

    <!-- TABLE -->

    <div class="table-responsive shadow rounded-4">

        <table class="table table-hover table-striped align-middle mb-0">

            <thead class="table-dark sticky-top">

                <tr>

                    <th>#</th>

                    <th>@Localizer["CustomerName"]</th>

                    <th>@Localizer["Phone"]</th>

                    <th>@Localizer["Total"]</th>

                    <th>@Localizer["Order"]</th>

                    <th>@Localizer["Payment"]</th>

                    <th>@Localizer["Delivery"]</th>

                    <th>@Localizer["Date"]</th>

                    <th></th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="fw-bold">
                            #@item.Id
                        </td>

                        <td>
                            @item.CustomerName
                        </td>

                        <td>
                            @item.Phone
                        </td>

                        <td class="fw-bold text-danger">

                            @item.Total.ToString("0.000")
                            @Localizer["Currency"]

                        </td>

                        <!-- ORDER STATUS -->

                        <td>

                            @if (item.OrderStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2">
                                    @Localizer["Pending"]
                                </span>
                            }
                            else if (item.OrderStatus == "Completed")
                            {
                                <span class="badge bg-success px-3 py-2">
                                    @Localizer["Completed"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">
                                    @item.OrderStatus
                                </span>
                            }

                        </td>

                        <!-- PAYMENT STATUS -->

                        <td>

                            @if (item.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success px-3 py-2">
                                    @Localizer["Paid"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">
                                    @Localizer["Unpaid"]
                                </span>
                            }

                        </td>

                        <!-- DELIVERY STATUS -->

                        <td>

                            @if (item.DeliveryStatus == "Preparing")
                            {
                                <span class="badge bg-primary px-3 py-2">
                                    @Localizer["Preparing"]
                                </span>
                            }
                            else if (item.DeliveryStatus == "Delivered")
                            {
                                <span class="badge bg-success px-3 py-2">
                                    @Localizer["Delivered"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">
                                    @item.DeliveryStatus
                                </span>
                            }

                        </td>

                        <td>
                            @item.OrderDate.ToString("dd/MM/yyyy hh:mm tt")
                        </td>

                        <td>

                            <a asp-controller="Admin"
                               asp-action="OrderDetails"
                               asp-route-id="@item.Id"
                               class="btn btn-dark btn-sm rounded-pill px-3">

                                <i class="bi bi-eye"></i>
                                @Localizer["View"]

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- PAGINATION -->

    <div class="d-flex justify-content-center mt-4 gap-2 flex-wrap">

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-controller="Admin"
               asp-action="Orders"
               asp-route-page="@i"
               class="btn @(ViewBag.CurrentPage == i
                                               ? "btn-dark"
                                               : "btn-outline-dark")">

            @i

            </a>
                }

    </div>

</div>