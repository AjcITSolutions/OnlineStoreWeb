@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer


@model List<OnlineStoreWeb.Models.ProductModel>


<div class="container mt-4">

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4" id="@item.Id">
                <div class="card h-100 shadow-sm">


                       <a href="/Products/Details/@item.Id">
                     <img src="@(string.IsNullOrEmpty(item.Image)
    ? "/images/no-image.png"
    : item.Image)"
     class="card-img-top product-image"
     alt="@item.Name"
     onerror="this.onerror=null; this.src='/images/no-image.png';">
           </a>

                    <div class="card-body">
                        <h5 class="card-title">
                               <a href="/Products/Details/@item.Id"
       class="text-dark text-decoration-none">
                            @item.Name
                                  </a>
                        </h5>
                        <p class="text-danger fw-bold">
                            @Localizer["Price"]: @item.Price JD
                        </p>

                        <div class="d-flex gap-2">

                            <a href="/Products/Details/@item.Id"
                               class="btn btn-outline-dark w-50 rounded-pill">
                                @Localizer["Details"]
                            </a>

                      <a href="#"
   class="btn btn-dark w-50 rounded-pill add-cart-btn"
   data-id="@item.Id"
   data-name="@item.Name"
 data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    @Localizer["AddToCart"]
</a> 

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>

</div>

</div>

<style>
    .product-image {
        height: 260px;
        object-fit: cover;
    }

    .card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .card-title {
        font-size: 18px;
        font-weight: bold;
        min-height: 50px;
    }
</style>