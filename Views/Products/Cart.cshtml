@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer


@model List<OnlineStoreWeb.Models.CartItemModel>

<div class="container mt-5">

    <h2 class="fw-bold mb-4">
        @Localizer["ShoppingCart"]
    </h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-cart-x"
               style="font-size:70px;color:#999;">
            </i>

            <h3 class="fw-bold mt-4">
                @Localizer["Cartisempty"]
            </h3>

            <p class="text-muted">
                لا يوجد منتجات داخل السلة
            </p>

            <a href="/"
               class="btn btn-dark px-5 py-3 rounded-pill mt-3">

                متابعة التسوق

            </a>

        </div>
    }
    else
    {
        decimal total = 0;

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>@Localizer["Image"]</th>
                        <th>@Localizer["Product"]</th>
                        <th>@Localizer["Price"]</th>
                        <th>@Localizer["Qty"]</th>
                        <th>@Localizer["Total"]</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        total += item.Price * item.Qty;

                        <tr>

                            <td width="120">
                                <img src="@(string.IsNullOrEmpty(item.Image)
                                         ? "/images/no-image.png"
                                         : item.Image)"
                             onerror="this.onerror=null; this.src='/images/no-image.png';"
                                     style="width:100px;height:100px;object-fit:cover;border-radius:12px;">
                            </td>

                            <td>
                                @item.Name
                            </td>

                            <td>
                              
                                @item.Price.ToString("0.000") @Localizer["Currency"]
                            </td>

                            <td>

                                <div class="d-flex align-items-center gap-2">

                                    <a href="/Products/DecreaseQty/@item.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        -
                                    </a>

                                    <span class="fw-bold">
                                        @item.Qty
                                    </span>

                                    <a href="/Products/IncreaseQty/@item.Id"
                                       class="btn btn-sm btn-dark">
                                        +
                                    </a>

                                </div>

                            </td>


                            <td class="fw-bold text-danger">
                                @(item.Price* item.Qty)  @Localizer["Currency"]
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="text-end mt-4">

            <h3 class="fw-bold">
                @Localizer["Total"]: <span class="text-danger">@total.ToString("0.000") @Localizer["Currency"]</span>
            </h3>

            <a href="/Products/Checkout"
               class="btn btn-dark px-5 py-3 rounded-pill mt-3">
                @Localizer["Checkout"]
            </a>

        </div>
    }

</div>