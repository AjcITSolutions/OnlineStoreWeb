@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model OnlineStoreWeb.Models.ProductModel

<div class="container mt-5">

    <div class="row">

        <div class="col-md-6">

            <img src="@(string.IsNullOrEmpty(Model.Image)
                          ? "https://via.placeholder.com/600x500"
                          : Model.Image)"
                 class="img-fluid rounded shadow">

        </div>

        <div class="col-md-6">

            <h1 class="fw-bold">
                @Model.Name
            </h1>

            <h2 class="text-danger mt-3">
                @Localizer["Price"]: @Model.Price JD
            </h2>

            <p class="mt-4 text-muted">

                @Model.Description

            </p>
            <a asp-controller="Products"
               asp-action="AddToCart"
               asp-route-id="@Model.Id"
               asp-route-name="@Model.Name"
               asp-route-price="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               class="btn btn-dark btn-lg mt-3 px-5">

                @Localizer["AddToCart"]

            </a>

        </div>

    </div>

</div>