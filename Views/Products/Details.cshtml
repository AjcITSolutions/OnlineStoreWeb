@model OnlineStoreWeb.Models.ProductModel

<div class="container mt-5">

    <div class="row">

        <div class="col-md-6">

            <img src="@(string.IsNullOrEmpty(Model.Image)
                          ? "https://via.placeholder.com/600x500"
                          : Model.Image)"
                 class="img-fluid rounded shadow">

        </div>

        <div class="col-md-6">

            <h1 class="fw-bold">
                @Model.Name
            </h1>

            <h2 class="text-danger mt-3">
                @Model.Price JD
            </h2>

            <p class="mt-4 text-muted">

                Premium quality luxury product.
                Elegant design and modern style.

            </p>

            <button class="btn btn-dark btn-lg mt-3 px-5">

                Add To Cart

            </button>

        </div>

    </div>

</div>