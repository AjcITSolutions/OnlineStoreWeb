                    @Localizer["TrackOrder"]
                </a>

            </div>



            <!-- LANGUAGE -->

            <div class="sidebar-language">

                <a href="/Home/ChangeLanguage?culture=ar"
                   class="lang-btn @(culture.StartsWith("ar") ? "active-lang" : "")">
                    عربي
                </a>

                <a href="/Home/ChangeLanguage?culture=en"
                   class="lang-btn @(culture.StartsWith("en") ? "active-lang" : "")">
                    English
                </a>

            </div>

    


            @{
    List<CategoryModel> categories =
        new List<CategoryModel>();

    try
    {
        using HttpClient client =
            new HttpClient();

        categories =
            await client.GetFromJsonAsync<List<CategoryModel>>
            (
                "https://ataonlinestoreapi.runasp.net/api/Categories"
            );
    }
    catch
    {
    }
}

            <div class="sidebar-title">
                SHOP BY CATEGORY
            </div>


       @foreach (var cat in categories)
{
    <a class="category-item"
       href="/Products?categoryId=@cat.Id">

        <i class="fas fa-folder me-2"></i>

        @cat.Name

    </a>
}

      

        </div>
    </div>


    <script>

let timer;

document
.getElementById("txtSearch")
.addEventListener("keyup", function () {

    clearTimeout(timer);

    let search = this.value;

if (search.length < 2)
{
    let resultsDiv =
        document.getElementById("searchResults");

    resultsDiv.innerHTML = "";
    resultsDiv.style.display = "none";

    return;
}

    timer = setTimeout(async function () {

        let response =
            await fetch(
                "https://ataonlinestoreapi.runasp.net/api/Products/autocomplete?search="
                + encodeURIComponent(search));

        let products =
            await response.json();

            console.log(products);

        let html = "";

        products.forEach(p => {

            html += `
<a class="search-item"
href="/Products/Details/${p.id}">

<img src="${p.image}" />

<div>
    <div>${p.name}</div>
    <small>${p.price} JD</small>
</div>

</a>
`;
        });
let resultsDiv =
    document.getElementById("searchResults");

resultsDiv.innerHTML = html;

if (html !== "")
{
    resultsDiv.style.display = "block";
}
else
{
    resultsDiv.style.display = "none";
}

    }, 300);

});

        document.addEventListener("click", function (e) {

            let results =
                document.getElementById("searchResults");

            let search =
                document.getElementById("txtSearch");

            if (
                !results.contains(e.target)
                &&
                e.target !== search
            )
            {
                let value =
                    search.value.trim();

                if (value.length > 0)
                {
                    window.location =
                        "/Products?search=" +
                        encodeURIComponent(value);
                }
            }

        });

</script>


<a href="https://wa.me/962797793823?text=مرحباً، أود الاستفسار عن أحد منتجات"
   target="_blank"
   class="whatsapp-float"
   target="_blank"
   class="whatsapp-float">

    <i class="fab fa-whatsapp"></i>

</a>


<script>

document.addEventListener("click", async function (e) {

    const btn = e.target.closest(".add-cart-btn");

    if (!btn)
        return;

    e.preventDefault();

    const id = btn.dataset.id;
    const name = btn.dataset.name;
    const price = btn.dataset.price;

    try {

        const response = await fetch(
            `/Products/AddToCart?id=${encodeURIComponent(id)}&name=${encodeURIComponent(name)}&price=${price}`,
            {
                method: "GET"
            });

        if (response.ok) {
document.querySelectorAll(".cart-badge")
    .forEach(badge => {

        let current =
            parseInt(badge.innerText || "0");

        badge.innerText = current + 1;
    });

            console.log("Added");
        }

    }
    catch (err) {

        console.error(err);
    }

});

</script>

</body>
