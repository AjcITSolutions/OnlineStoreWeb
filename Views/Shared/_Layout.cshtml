    <script>
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js')
            .then(() => console.log('PWA Ready'));
    }
</script>

<script>
    // حفظ مكان التمرير
    window.onload = function () {

        const scrollPos =
            sessionStorage.getItem("scrollPos");

        if (scrollPos) {

            window.scrollTo(0, parseInt(scrollPos));

            sessionStorage.removeItem("scrollPos");
        }
    };

    // حفظ المكان قبل Add To Cart
    document.addEventListener("click", function (e) {

        const target = e.target.closest("a");

        if (target &&
            target.href.includes("AddToCart")) {

            sessionStorage.setItem(
                "scrollPos",
                window.scrollY
            );
        }
    });
</script>

    <div class="offcanvas offcanvas-start"
         tabindex="-1"
         id="categoriesSidebar">

        <div class="offcanvas-header">

            <h5 class="offcanvas-title">
                Categories
            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>

        </div>

        <div class="offcanvas-body p-0">



            <!-- MOBILE MENU LINKS -->


            
            <!-- search -->
                <div class="sidebar-search position-relative">

    <form method="get" action="/Products">

        <input type="text"
               id="txtSearch"
               name="search"
               class="form-control"
               autocomplete="off"
               placeholder="@Localizer["Search"]">

    </form>

    <div id="searchResults"
         class="search-results">
    </div>

</div>


            <div class="sidebar-menu-links">

                <a class="sidebar-link" href="/">
                    <i class="fas fa-home me-2"></i>
                    @Localizer["Home"]
                </a>

                <a class="sidebar-link" href="/Products">
